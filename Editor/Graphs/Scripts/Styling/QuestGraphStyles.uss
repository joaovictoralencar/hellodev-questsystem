/* Quest Graph Editor Styles
 * Custom styling for quest graph nodes
 * These styles are applied via Graph Toolkit's style sheet system
 */

/* ==========================================================================
   Node Base Styles
   ========================================================================== */

/* All quest nodes get a subtle border */
.quest-base-node {
    border-width: 1px;
    border-radius: 4px;
}

/* ==========================================================================
   Start Nodes - Green theme (entry points)
   ========================================================================== */

.quest-start-node {
    background-color: #1a472a;
    border-color: #4CAF50;
    border-width: 2px;
}

.quest-start-node:hover {
    background-color: #225533;
    border-color: #66BB6A;
}

.quest-start-node:selected {
    background-color: #2d6b3d;
    border-color: #81C784;
    border-width: 3px;
}

.questline-start-node {
    background-color: #1a472a;
    border-color: #4CAF50;
    border-width: 2px;
}

/* ==========================================================================
   Stage Nodes - Blue-green theme (main progression)
   ========================================================================== */

.stage-node {
    background-color: #2d5a27;
    border-color: #66BB6A;
}

.stage-node:hover {
    background-color: #3a6b34;
}

.stage-node:selected {
    border-color: #81C784;
    border-width: 2px;
}

/* Terminal stage - Red accent to indicate endpoint */
.stage-node.terminal {
    background-color: #5a2727;
    border-color: #ff6b6b;
    border-width: 2px;
}

.stage-node.terminal:hover {
    background-color: #6b3333;
}

/* Optional stage - Yellow accent */
.stage-node.optional {
    border-color: #FFD54F;
    border-style: dashed;
}

/* Hidden stage - Gray with transparency */
.stage-node.hidden {
    opacity: 0.7;
    border-style: dotted;
}

/* ==========================================================================
   Choice Nodes - Blue theme (player decisions)
   ========================================================================== */

.choice-node {
    background-color: #27455a;
    border-color: #42A5F5;
}

.choice-node:hover {
    background-color: #325566;
}

.choice-node:selected {
    border-color: #64B5F6;
    border-width: 2px;
}

/* ==========================================================================
   Task Group Nodes - Gray theme (work containers)
   ========================================================================== */

.task-group-node {
    background-color: #3d3d3d;
    border-color: #757575;
}

.task-group-node:hover {
    background-color: #4a4a4a;
}

.task-group-node:selected {
    border-color: #9E9E9E;
    border-width: 2px;
}

/* ==========================================================================
   Task Nodes - Dark gray (individual tasks)
   ========================================================================== */

.task-node {
    background-color: #2d2d2d;
    border-color: #616161;
}

.task-node:hover {
    background-color: #383838;
}

.task-node:selected {
    border-color: #9E9E9E;
    border-width: 2px;
}

/* ==========================================================================
   Quest Reference Nodes - Purple theme (references)
   ========================================================================== */

.quest-ref-node {
    background-color: #3d2d5a;
    border-color: #9C27B0;
}

.quest-ref-node:hover {
    background-color: #4a3866;
}

.quest-ref-node:selected {
    border-color: #BA68C8;
    border-width: 2px;
}

/* Optional quest reference */
.quest-ref-node.optional {
    border-style: dashed;
    border-color: #CE93D8;
}

/* ==========================================================================
   Subgraph Nodes - Dashed borders (embedded content)
   ========================================================================== */

.subgraph-node {
    border-style: dashed;
    border-width: 2px;
}

.stage-subgraph-node {
    background-color: #2d5a27;
    border-color: #66BB6A;
    border-style: dashed;
}

.task-group-subgraph-node {
    background-color: #3d3d3d;
    border-color: #757575;
    border-style: dashed;
}

/* ==========================================================================
   Port Styles by Flow Type
   ========================================================================== */

/* Quest flow ports - Purple */
.port.quest-flow .connector {
    background-color: #9C27B0;
}

.port.quest-flow:hover .connector {
    background-color: #BA68C8;
}

/* Stage flow ports - Green */
.port.stage-flow .connector {
    background-color: #4CAF50;
}

.port.stage-flow:hover .connector {
    background-color: #66BB6A;
}

/* Task flow ports - Gray */
.port.task-flow .connector {
    background-color: #757575;
}

.port.task-flow:hover .connector {
    background-color: #9E9E9E;
}

/* Choice flow ports - Blue */
.port.choice-flow .connector {
    background-color: #42A5F5;
}

.port.choice-flow:hover .connector {
    background-color: #64B5F6;
}

/* Condition result ports - Orange */
.port.condition-result .connector {
    background-color: #FF9800;
}

.port.condition-result:hover .connector {
    background-color: #FFB74D;
}

/* ==========================================================================
   Validation Visual States
   ========================================================================== */

/* Node with validation error */
.node.validation-error {
    border-color: #F44336;
    border-width: 3px;
}

/* Node with validation warning */
.node.validation-warning {
    border-color: #FF9800;
    border-width: 2px;
}

/* Unreachable node (from reachability analysis) */
.node.unreachable {
    opacity: 0.5;
    border-style: dotted;
    border-color: #F44336;
}

/* ==========================================================================
   Edge/Wire Styles
   ========================================================================== */

.edge {
    --edge-width: 2;
}

.edge:hover {
    --edge-width: 3;
}

.edge:selected {
    --edge-width: 4;
}

/* ==========================================================================
   Graph Background
   ========================================================================== */

.graph-view {
    --grid-background-color: #1e1e1e;
    --line-color: rgba(255, 255, 255, 0.05);
    --thick-line-color: rgba(255, 255, 255, 0.1);
}

/* ==========================================================================
   Node Title Styling
   ========================================================================== */

.node-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #ffffff;
}

.node-title.terminal {
    color: #ff6b6b;
}

.node-title.optional {
    color: #FFD54F;
}

/* ==========================================================================
   Icon Indicators
   ========================================================================== */

.terminal-indicator {
    background-color: #F44336;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin: 2px;
}

.optional-indicator {
    background-color: #FFD54F;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin: 2px;
}

.hidden-indicator {
    background-color: #9E9E9E;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin: 2px;
}
