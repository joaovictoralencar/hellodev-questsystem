  m_TableData:
  - m_Id: 287187189760
    m_Localized: "Bem-vindo! Vamos aprender os controles b\xE1sicos."
    m_Metadata:
      m_Items:
      - rid: 2249559676743319659
  - m_Id: 287203966976
    m_Localized: Mova o mouse <sprite name=look> para olhar ao redor.
    m_Metadata:
      m_Items:
      - rid: 2249559676743319659
  - m_Id: 287203966977
    m_Localized: "Use <sprite name=Move/WASD/Up> <sprite name=Move/WASD/Left><sprite
      name=Move/WASD/Down> <sprite name=Move/WASD/Right> para se mover em diferentes
      dire\xE7\xF5es."
    m_Metadata:
      m_Items:
      - rid: 2249559676743319659
  - m_Id: 287203966978
    m_Localized: Pressione <sprite name=jump> para pular. ({current}/{required})
    m_Metadata:
      m_Items:
      - rid: 2249559676743319659
  - m_Id: 1464224994869248
    m_Localized: Pressione <sprite name=sprint> para correr.
    m_Metadata:
      m_Items: []
  - m_Id: 1500396701925376
    m_Localized: "Bom trabalho! Agora voc\xEA sabe os controles b\xE1sicos."
    m_Metadata:
      m_Items: []
