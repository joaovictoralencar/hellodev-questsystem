    - rid: 2249559676743319658
  m_TableData:
  - m_Id: 287187189760
    m_Localized: Welcome! Let's learn the basic controls.
    m_Metadata:
      m_Items:
      - rid: 2249559676743319658
  - m_Id: 287203966976
    m_Localized: Move your mouse <sprite name=look> to look around.
    m_Metadata:
      m_Items:
      - rid: 2249559676743319658
  - m_Id: 287203966977
    m_Localized: Use <sprite name=Move/WASD/Up> <sprite name=Move/WASD/Left><sprite
      name=Move/WASD/Down> <sprite name=Move/WASD/Right> to move in different directions.
    m_Metadata:
      m_Items:
      - rid: 2249559676743319658
  - m_Id: 287203966978
    m_Localized: Press <sprite name=jump> to jump. ({current}/{required})
    m_Metadata:
      m_Items:
      - rid: 2249559676743319658
  - m_Id: 1464224994869248
    m_Localized: Press <sprite name=sprint> to sprint.
    m_Metadata:
      m_Items: []
  - m_Id: 1500396701925376
    m_Localized: Well done! Now you know the basics controls.
    m_Metadata:
      m_Items: []
